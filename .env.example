# Copy to .env.local and fill in. Without GEMINI_API_KEY the app runs in mock AI mode.
GEMINI_API_KEY=
# Any Gemini model that supports generateContent with JSON output.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: request timeout in milliseconds.
AI_TIMEOUT_MS=45000

# Usage limits that protect your Gemini quota (all optional; defaults shown).
# When a limit is reached the free offline mock answers instead of Gemini.
AI_RATE_LIMIT_PER_IP=10
AI_RATE_LIMIT_WINDOW_SEC=600
AI_DAILY_LIMIT=200

# Optional but recommended on Vercel: shared counters make the limits exact across all
# serverless instances. Use Upstash Redis (Vercel Marketplace sets KV_REST_API_URL and
# KV_REST_API_TOKEN automatically; the UPSTASH_* names also work). Without them the
# limits are tracked in memory, per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
